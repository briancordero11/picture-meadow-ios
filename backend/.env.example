# Copy settings into your shell or hosting service. This app does not load .env files.
HOST=127.0.0.1
PORT=8787
# No browser origins are allowed by default. Native URLSession requests have no Origin.
CORS_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
MAX_BODY_BYTES=2048
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_CLIENTS=10000

# Optional AI scenes are OFF until an operator configures every required setting.
SCENE_GENERATION_ENABLED=false
# Generate a random 32–256 ASCII character access code; store securely on the server.
# The grown-up enters it in app Settings; never embed it in the app or source.
SCENE_ACCESS_TOKEN=
# Example verified in the live model catalog on 2026-11-11. Recheck before enabling.
AI_GATEWAY_MODEL=google/gemini-nano-banana-2.1
# For local/non-Vercel hosting only. Vercel deployments use injected OIDC instead.
AI_GATEWAY_API_KEY=
